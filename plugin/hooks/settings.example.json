{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/YourName/.claude/hooks/session_start.py\" --tools-dir \"C:/AI/office-kit/tools\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|apply_patch|Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/YourName/.claude/hooks/block_dangerous.py\""
          },
          {
            "type": "command",
            "command": "python \"C:/Users/YourName/.claude/hooks/skill_gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/YourName/.claude/hooks/skill_gate.py\""
          }
        ]
      }
    ]
  }
}
